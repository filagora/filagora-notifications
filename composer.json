{
    "name": "filagora/filagora-notifications",
    "description": "Notification preferences for Filagora: per-person, per-category, per-channel choices, a category registry, suppression, signed unsubscribe, and bridges to push and forums.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filagora",
        "notifications",
        "preferences"
    ],
    "require": {
        "filagora/filagora-core": "^0.2.2",
        "filament/filament": "^5.0",
        "php": "^8.4"
    },
    "require-dev": {
        "filagora/filagora-entitlements": "^0.2.2",
        "filagora/filagora-forums": "^0.6",
        "filagora/filagora-messages": "^0.2",
        "filagora/filagora-push": "^0.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\Notifications\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\Notifications\\NotificationsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "filagora/filagora-entitlements": "Declares the staff ability to see a person's stored choices, so it can be granted in the entitlements screens.",
        "filagora/filagora-forums": "Bridges thread subscription delivery to the person's choices.",
        "filagora/filagora-messages": "Bridges who may be messaged to the person's choice.",
        "filagora/filagora-push": "Bridges push alerts to the person's choices."
    }
}
